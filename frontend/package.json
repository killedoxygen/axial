{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "24.13.1"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "clean": "node esbuild.mjs clean",
    "dev": "node esbuild.mjs serve",
    "dev:desktop": "node esbuild.mjs serve --strict-port",
    "dev:mock": "node esbuild.mjs serve --strict-port --mock",
    "watch": "node esbuild.mjs watch",
    "test": "node test/run.mjs",
    "verify": "pnpm run lint:semantic && pnpm run format:check && pnpm run test && pnpm run build",
    "lint": "tsc --noEmit && pnpm run lint:semantic",
    "lint:semantic": "biome lint src",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "mime-types": "3.0.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "lucide-preact": "1.61.0",
    "preact": "^11.0.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1"
  }
}
